{
  "name": "conquista-front",
  "version": "6.1.0",
  "private": true,
  "homepage": "/conquista",
  "proxy": "http://localhost:8080",
  "scripts": {
    "raise-db": "nodemon json-server.js --delay 1",
    "start": "env-cmd -f .env.development react-scripts start",
    "local": "env-cmd -f .env.local react-scripts start",
    "build": "env-cmd -f .env.development react-scripts build",
    "build:prod": "env-cmd -f .env react-scripts build",
    "extract": "env-cmd -f .env node extractBundle.js",
    "extractQa": "env-cmd -f .env.development node extractBundle.js",
    "test": "cross-env CI=true react-scripts test -u --forceExit --coverage --coverageDirectory=output/coverage/jest --env=jest-environment-jsdom-sixteen",
    "test:coverage": "react-scripts test --coverage --watchAll=false --env=jest-environment-jsdom-sixteen",
    "test:ci": "react-scripts test --watchAll=false --forceExit --coverage --testResultsProcessor=jest-sonar-reporter  --env=jest-environment-jsdom-sixteen",
    "test:watch": "react-scripts test --env=jest-environment-jsdom-sixteen",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{js, css, html, json, ts, tsx}\"",
    "lint": "eslint \"src/**/*.{js, css, html, json, ts, tsx}\"",
    "localAPI": "cross-env NODE_TLS_REJECT_UNAUTHORIZED='0' node localAPI",
    "cy:run": "./node_modules/.bin/cypress run",
    "cy:open": "./node_modules/.bin/cypress open",
    "percy": "percy exec -- ./node_modules/.bin/cypress run",
    "percy:open": "percy exec -- ./node_modules/.bin/cypress open",
    "swagger:start": "http-server ./mock-server/definition/ --cors=true -o /swagger-ui/index.html -p 9090",
    "swagger:test": "openapi-generator-cli validate -i ./mock-server/definition/openapi.yaml",
    "mock:start": "nodemon ./mock-server/server.js",
    "novo": "env-cmd -f .env.novo react-scripts start",
    "sonar:scan": "sonar-scanner"
  },
  "dependencies": {
    "@nivo/bar": "^0.61.1",
    "@nivo/line": "^0.61.1",
    "@nivo/pie": "^0.62.0",
    "@types/jest": "24.0.20",
    "@types/node": "12.11.7",
    "@types/react": "16.9.11",
    "@types/react-dom": "16.9.3",
    "@types/react-gtm-module": "^2.0.0",
    "@types/react-redux": "^7.1.5",
    "@types/react-router-dom": "^5.1.1",
    "@types/react-slick": "^0.23.4",
    "@types/yup": "^0.26.30",
    "axios": "^0.19.0",
    "crypto-js": "^3.1.9-1",
    "dotenv": "^8.2.0",
    "env-cmd": "^10.0.1",
    "immer": "^5.0.0",
    "js-cookie": "^2.2.1",
    "logstash": "^3.0.0",
    "moment": "^2.28.0",
    "react": "^16.11.0",
    "react-dates": "^21.8.0",
    "react-dom": "^16.11.0",
    "react-gtm-module": "^2.0.8",
    "react-helmet": "^6.1.0",
    "react-input-mask": "^3.0.0-alpha.2",
    "react-loading-skeleton": "^2.1.1",
    "react-popper": "^1.3.7",
    "react-redux": "^7.1.3",
    "react-router-dom": "^5.1.2",
    "react-scripts": "3.2.0",
    "react-slick": "^0.25.2",
    "react-spring": "^8.0.27",
    "react-table": "^7.5.0",
    "react-table-sticky": "^1.1.2",
    "react-toastify": "^5.5.0",
    "redux": "^4.0.4",
    "redux-mock-store": "^1.5.4",
    "redux-saga": "^1.1.3",
    "slick-carousel": "^1.8.1",
    "smoothscroll-polyfill": "^0.4.4",
    "styled-bootstrap-grid": "^3.0.5",
    "styled-components": "^5.1.1",
    "typescript": "^3.7.2",
    "uuidv4": "^6.0.7",
    "yup": "^0.28.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.0.3",
    "@percy/cypress": "^2.3.1",
    "@testing-library/cypress": "^5.3.0",
    "@testing-library/dom": "^7.20.1",
    "@testing-library/jest-dom": "^5.11.0",
    "@testing-library/react": "^10.2.0",
    "@testing-library/react-hooks": "^4.0.0",
    "@testing-library/user-event": "^12.0.11",
    "@types/js-cookie": "^2.2.6",
    "@types/moment": "^2.13.0",
    "@types/react-dates": "^21.8.0",
    "@types/react-helmet": "^6.0.0",
    "@types/react-input-mask": "^3.0.0",
    "@types/react-table": "^7.0.22",
    "@types/styled-components": "^5.1.0",
    "babel-eslint": "^10.0.3",
    "babel-plugin-styled-components": "^1.10.7",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.0",
    "cypress": "^4.9.0",
    "cypress-wait-until": "^1.7.1",
    "eslint": "^6.6.0",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^6.5.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.16.0",
    "eslint-plugin-react-hooks": "^2.2.0",
    "express": "^4.17.1",
    "faker": "^5.1.0",
    "husky": "^3.0.9",
    "jest-environment-jsdom-sixteen": "^1.0.3",
    "jest-sonar-reporter": "^2.0.0",
    "jest-styled-components": "^7.0.2",
    "json-server": "^0.15.1",
    "mq-polyfill": "^1.1.8",
    "nodemon": "^2.0.2",
    "prettier": "^1.18.2",
    "prop-types": "^15.7.2",
    "react-test-renderer": "^16.11.0",
    "sonarqube-scanner": "^2.7.0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version",
      "ie 11",
      "ie 10"
    ]
  },
  "jestSonar": {
    "sonar56x": true,
    "reportPath": "coverage",
    "reportFile": "test-report.xml",
    "indent": 4
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}"
    ],
    "coverageReporters": [
      "text",
      "cobertura",
      "lcov"
    ]
  }
}
