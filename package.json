{
  "name": "conquinsta-front",
  "version": "0.1.0",
  "private": true,
  "homepage": "/conquista",
  "proxy": "http://localhost:8080",
  "scripts": {
    "raise-db": "nodemon json-server.js",
    "start": "env-cmd -f .env.development react-scripts start",
    "local": "env-cmd -f .env.local react-scripts start",
    "build": "env-cmd -f .env.development react-scripts build",
    "build:prod": "env-cmd -f .env react-scripts build",
    "extract": "env-cmd -f .env node extractBundle.js",
    "extractQa": "env-cmd -f .env.development node extractBundle.js",
    "test": "cross-env CI=true react-scripts test -u --forceExit",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{js, css, html, json}\"",
    "lint": "eslint \"src/**/*.{js, css, html, json}\"",
    "localAPI": "node localAPI"
  },
  "dependencies": {
    "@nivo/bar": "^0.61.1",
    "@nivo/line": "^0.61.1",
    "@nivo/pie": "^0.59.1",
    "@types/jest": "24.0.20",
    "@types/node": "12.11.7",
    "@types/react": "16.9.11",
    "@types/react-dom": "16.9.3",
    "@types/react-gtm-module": "^2.0.0",
    "@types/react-redux": "^7.1.5",
    "@types/react-router-dom": "^5.1.1",
    "@types/react-slick": "^0.23.4",
    "@types/yup": "^0.26.30",
    "axios": "^0.19.0",
    "crypto-js": "^3.1.9-1",
    "dotenv": "^8.2.0",
    "env-cmd": "^10.0.1",
    "immer": "^5.0.0",
    "js-cookie": "^2.2.1",
    "moment": "^2.24.0",
    "react": "^16.11.0",
    "react-dom": "^16.11.0",
    "react-gtm-module": "^2.0.8",
    "react-popper": "^1.3.7",
    "react-redux": "^7.1.3",
    "react-router-dom": "^5.1.2",
    "react-scripts": "3.2.0",
    "react-slick": "^0.25.2",
    "react-spring": "^8.0.27",
    "react-table": "^7.0.0-beta.12",
    "react-table-sticky": "^1.1.2",
    "react-toastify": "^5.5.0",
    "redux": "^4.0.4",
    "redux-mock-store": "^1.5.4",
    "redux-saga": "^1.1.3",
    "slick-carousel": "^1.8.1",
    "smoothscroll-polyfill": "^0.4.4",
    "styled-bootstrap-grid": "^3.0.5",
    "styled-components": "^5.1.1",
    "typescript": "^3.7.2",
    "uuidv4": "^6.0.7",
    "yup": "^0.28.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.9.0",
    "@testing-library/react": "^10.2.0",
    "@types/js-cookie": "^2.2.6",
    "@types/react-table": "^7.0.16",
    "@types/styled-components": "^5.1.0",
    "babel-eslint": "^10.0.3",
    "babel-plugin-styled-components": "^1.10.7",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.0",
    "eslint": "^6.6.0",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^6.5.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.16.0",
    "eslint-plugin-react-hooks": "^2.2.0",
    "express": "^4.17.1",
    "husky": "^3.0.9",
    "jest-sonar-reporter": "^2.0.0",
    "jest-styled-components": "^7.0.2",
    "json-server": "^0.15.1",
    "nodemon": "^2.0.2",
    "prettier": "^1.18.2",
    "prop-types": "^15.7.2",
    "react-test-renderer": "^16.11.0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version",
      "ie 11",
      "ie 10"
    ]
  },
  "jestSonar": {
    "sonar56x": true,
    "reportPath": "coverage",
    "reportFile": "sonar-report.xml",
    "indent": 4
  }
}
