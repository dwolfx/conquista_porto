                    aria-label="plus"
                    fill="#FFFFFF"
                    role="img"
                    width={12}
                  >
                    plus.svg
                  </svg>
                </span>
              </button>
            </div>
          </div>
          <button
            className="c20 c31"
            color="primary"
            data-gtm-clicktype="button"
            data-gtm-name="proximo"
            data-gtm-type="click"
            disabled={true}
