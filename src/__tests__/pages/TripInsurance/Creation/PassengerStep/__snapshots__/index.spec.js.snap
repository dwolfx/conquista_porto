<div
    className="c0"
    data-testid="passenger-step"
  >
    <div
      className="sc-AxjAm c1"
      data-name="container"
    >
      <div
        className="sc-AxirZ c2"
        data-name="row align-items-center justify-content-start"
      >
        <div
          className="c3"
          data-name="col-auto col-md-3 hidden-md-down"
        >
          <div
            className="c4"
          >
            <h4
              className="c5 c6"
              color="gray6"
              type="heading4"
            >
              Passageiros
            </h4>
            <div
              className="c7 c8"
            />
            <h5
              className="c9 c6"
              color="gray6"
              type="headline"
            >
              O seguro cobre até 20 passageiros, incluindo você.
            </h5>
          </div>
        </div>
        <div
          className="c10"
          data-name="offset-1 col-xs-12 col-sm-7 col-md-4"
          offset={1}
        >
          <div
            className="c11"
          >
            <h5
              className="c12"
              color="gray6"
              type="headline"
            >
              Quantos passageiros haverá na viagem?
              <span
                className="c13"
                onMouseEnter={[Function]}
                onMouseLeave={[Function]}
              >
                <svg
                  aria-label="info-passengers"
                  data-testid="passenger-info"
                  fill="#00ADEF"
                  height={21}
                  role="button"
                  width={21}
                >
                  information.svg
                </svg>
              </span>
            </h5>
            <span
              className="c14 c15"
              color="gray5"
              type="caption"
            >
              Indique o número de passageiros, incluindo você. Considere a idade atual de todos com base na data de hoje.
            </span>
          </div>
          <div
            className="c16 c17"
          >
            <label
              className=""
            >
              <span
                className="c18 "
                color="gray5"
                type="captionUppercase"
              >
                PASSAGEIROS ATÉ 70 ANOS
              </span>
            </label>
            <div
              className="c19"
            >
              <button
                className="c20 c21"
                color="primary"
                data-testid="-subtract-button"
                disabled={true}
                onClick={[Function]}
              >
                <span
                  className="c22"
                >
                  <svg
                    aria-label="subtract"
                    fill="#BABABA"
                    role="img"
                    width={12}
                  >
                    subtract.svg
                  </svg>
                </span>
              </button>
              <div
                className="c23 c24"
                disabled={false}
              >
                <div
                  className="c25"
                >
                  <div
                    className="c26 c27"
                    onClick={[Function]}
                  >
                    <input
                      className="c28"
                      data-testid="input-number-"
                      disabled={false}
                      max={20}
                      min={0}
                      onChange={[Function]}
                      type="number"
                      value="0"
                    />
                  </div>
                </div>
              </div>
              <button
                className="c29 c30"
                color="primary"
                data-testid="-add-button"
                disabled={false}
                onClick={[Function]}
              >
                <span
                  className="c22"
                >
                  <svg
                    aria-label="plus"
                    fill="#FFFFFF"
                    role="img"
                    width={12}
                  >
                    plus.svg
                  </svg>
                </span>
              </button>
            </div>
          </div>
          <div
            className="c16 c17"
          >
            <label
              className=""
            >
              <span
                className="c18 "
                color="gray5"
                type="captionUppercase"
              >
                PASSAGEIROS DE 71 ATÉ 90 ANOS 
              </span>
            </label>
            <div
              className="c19"
            >
              <button
                className="c20 c21"
                color="primary"
                data-testid="-subtract-button"
                disabled={true}
                onClick={[Function]}
              >
                <span
                  className="c22"
                >
                  <svg
                    aria-label="subtract"
                    fill="#BABABA"
                    role="img"
                    width={12}
                  >
                    subtract.svg
                  </svg>
                </span>
              </button>
              <div
                className="c23 c24"
                disabled={false}
              >
                <div
                  className="c25"
                >
                  <div
                    className="c26 c27"
                    onClick={[Function]}
                  >
                    <input
                      className="c28"
                      data-testid="input-number-"
                      disabled={false}
                      max={20}
                      min={0}
                      onChange={[Function]}
                      type="number"
                      value="0"
                    />
                  </div>
                </div>
              </div>
              <button
                className="c29 c30"
                color="primary"
