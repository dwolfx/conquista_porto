  .c1 {
  background: #FFFFFF;
  background-repeat: no-repeat;
  border: 1px solid #00ADEF;
  border-radius: 4px;
  box-sizing: border-box;
  display: inline-block;
  color: #00ADEF;
  cursor: pointer;
  height: 35px;
  overflow: hidden;
  position: relative;
  -webkit-text-decoration: none;
  text-decoration: none;
  -webkit-transition: all 0.4s ease-out;
  transition: all 0.4s ease-out;
}

.c1:hover:active {
  pointer-events: auto;
}

.c1:hover:active:after {
  background-color: #EFFBFF;
  background-size: 100%;
  opacity: 0.2;
  -webkit-transition: all ease 0s;
  transition: all ease 0s;
}

.c1:hover:before {
  width: 100%;
}

.c1:hover:after {
  background: transparent radial-gradient( circle, #000 1%, transparent 1% ) center/15000%;
  background-position: center;
  content: '';
  height: 100%;
  left: 0;
  opacity: 0;
  pointer-events: none;
  position: absolute;
  top: 0;
  -webkit-transition: all ease 0.8s;
  transition: all ease 0.8s;
  width: 100%;
}

.c1:before {
  background-color: #EFFBFF;
  content: '';
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  -webkit-transition: width 0.2s ease-in;
  transition: width 0.2s ease-in;
  width: 0;
}

.c6 {
  background: #EBEBEB;
  background-repeat: no-repeat;
  border: none;
  border-radius: 4px;
  box-sizing: border-box;
  display: inline-block;
  color: #BABABA;
  cursor: not-allowed;
  height: 35px;
  overflow: hidden;
  position: relative;
  -webkit-text-decoration: none;
  text-decoration: none;
  -webkit-transition: all 0.4s ease-out;
  transition: all 0.4s ease-out;
}

.c6:hover:active {
  pointer-events: none;
}

.c6:hover:active:after {
  background-color: #2F736B;
  background-size: 100%;
  opacity: 0.2;
  -webkit-transition: all ease 0s;
  transition: all ease 0s;
}

.c6:before {
  background-color: #2F736B;
  content: '';
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  -webkit-transition: width 0.2s ease-in;
  transition: width 0.2s ease-in;
  width: 0;
}

.c3 {
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
  -ms-flex-pack: center;
  justify-content: center;
  height: 100%;
  padding: 0 25px;
  position: relative;
  width: 100%;
  font-size: 11px;
  font-weight: 600;
  -webkit-letter-spacing: 1.5px;
  -moz-letter-spacing: 1.5px;
  -ms-letter-spacing: 1.5px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  line-height: 15px;
}

.c4 {
  cursor: pointer;
}

.c0 {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  border: 1px solid #DDDDDD;
  background-color: #FFFFFF;
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
  -ms-flex-pack: end;
  justify-content: flex-end;
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  padding-right: 35px;
  width: 100vw;
  height: 63px;
}

.c2:first-child {
  margin-left: 14px;
}

