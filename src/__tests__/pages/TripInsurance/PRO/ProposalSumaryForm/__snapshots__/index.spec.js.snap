  .c1 {
  width: 100%;
  padding-right: 15px;
  padding-left: 15px;
  margin-right: auto;
  margin-left: auto;
}

.c2 {
  display: -ms-flexbox;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-wrap: wrap;
  -webkit-flex-wrap: wrap;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  margin-right: -15px;
  margin-left: -15px;
}

.c3 {
  position: relative;
  width: 100%;
  min-height: 1px;
  padding-right: 15px;
  padding-left: 15px;
}

.c5 {
  background: #FFFFFF;
  background-repeat: no-repeat;
  border: 1px solid #00ADEF;
  border-radius: 4px;
  box-sizing: border-box;
  display: inline-block;
  color: #00ADEF;
  cursor: pointer;
  height: 35px;
  overflow: hidden;
  position: relative;
  -webkit-text-decoration: none;
  text-decoration: none;
  -webkit-transition: all 0.4s ease-out;
  transition: all 0.4s ease-out;
}

.c5:hover:active {
  pointer-events: auto;
}

.c5:hover:active:after {
  background-color: #EFFBFF;
  background-size: 100%;
  opacity: 0.2;
  -webkit-transition: all ease 0s;
  transition: all ease 0s;
}

.c5:hover:before {
  width: 100%;
}

.c5:hover:after {
  background: transparent radial-gradient( circle, #000 1%, transparent 1% ) center/15000%;
  background-position: center;
  content: '';
  height: 100%;
  left: 0;
  opacity: 0;
  pointer-events: none;
  position: absolute;
  top: 0;
  -webkit-transition: all ease 0.8s;
  transition: all ease 0.8s;
  width: 100%;
}

.c5:before {
  background-color: #EFFBFF;
  content: '';
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  -webkit-transition: width 0.2s ease-in;
  transition: width 0.2s ease-in;
  width: 0;
}

.c10 {
  background: #EBEBEB;
  background-repeat: no-repeat;
  border: none;
  border-radius: 4px;
  box-sizing: border-box;
  display: inline-block;
  color: #BABABA;
  cursor: not-allowed;
  height: 35px;
  overflow: hidden;
  position: relative;
  -webkit-text-decoration: none;
  text-decoration: none;
  -webkit-transition: all 0.4s ease-out;
  transition: all 0.4s ease-out;
}

.c10:hover:active {
  pointer-events: none;
}

.c10:hover:active:after {
  background-color: #2F736B;
  background-size: 100%;
  opacity: 0.2;
  -webkit-transition: all ease 0s;
  transition: all ease 0s;
}

.c10:before {
  background-color: #2F736B;
  content: '';
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  -webkit-transition: width 0.2s ease-in;
  transition: width 0.2s ease-in;
  width: 0;
}

.c7 {
  -webkit-align-items: center;
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
  -ms-flex-pack: center;
  justify-content: center;
  height: 100%;
  padding: 0 25px;
  position: relative;
  width: 100%;
  font-size: 11px;
  font-weight: 600;
  -webkit-letter-spacing: 1.5px;
  -moz-letter-spacing: 1.5px;
  -ms-letter-spacing: 1.5px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  line-height: 15px;
}

.c8 {
  cursor: pointer;
}

.c0 {
  position: fixed;
  bottom: 0;
  width: 100%;
  border-top: 1px solid #DDDDDD;
  background-color: #FFFFFF;
  padding: 14px;
}

.c4 {
  position: relative;
  width: 100%;
  min-height: 1px;
  padding-right: 15px;
  padding-left: 15px;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
  -ms-flex-direction: column;
  flex-direction: column;
  -webkit-box-pack: end;
  -webkit-justify-content: flex-end;
  -ms-flex-pack: end;
  justify-content: flex-end;
  padding: 0;
}

.c4 > :first-child {
  margin-right: 14px;
}

.c6 {
