  font-size: 11px;
  font-weight: 600;
  -webkit-letter-spacing: 1.5px;
  -moz-letter-spacing: 1.5px;
  -ms-letter-spacing: 1.5px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  line-height: 15px;
}

.c76 svg {
  height: 21px;
}

.c76 svg path {
  fill: currentColor;
}

