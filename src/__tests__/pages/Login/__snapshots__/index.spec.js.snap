          className="c4"
          data-name=""
        >
          <p
            className="c6"
            color="gray5"
            type="subheading"
          >
            Você pode acessar com a senha do Portal do Cliente
          </p>
        </div>
        <div
          className="c4"
          data-name=""
        >
          <div
            className="c7"
            disabled={false}
            width="100%"
          >
            <label
              className="c8 c9"
            >
              Username
            </label>
            <input
              className="c10 c11"
              data-testid="cpf-input"
              maxLength="14"
              name="username"
              onChange={[Function]}
              onKeyUp={[Function]}
              type="text"
              value=""
            />
          </div>
        </div>
        <div
          className="c4"
          data-name=""
        >
          <div
            className="c7"
            disabled={false}
            width="100%"
          >
            <label
              className="c8 c9"
            >
              Password
            </label>
            <input
              className="c10 c11"
              data-testid="password-input"
              name="password"
              onChange={[Function]}
              onKeyUp={[Function]}
              type="password"
              value=""
            />
          </div>
        </div>
        <div
          className="c4"
          data-name=""
        >
          <button
            className="c12"
            color="primary"
            data-testid="login-button"
            disabled={false}
            onClick={[Function]}
          >
            <span
              className="c13"
            >
              Login
            </span>
          </button>
        </div>
      </form>
    </div>
  </div>
  <div
    className="c1"
    data-name="row"
  >
    Versão Teste
  </div>
</div>
`;
