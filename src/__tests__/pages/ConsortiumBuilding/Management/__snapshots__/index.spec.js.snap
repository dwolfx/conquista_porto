<div
    className="c0"
    data-name="container"
  >
    <div
      className="c1"
      data-name="row"
    >
      <div
        className="sc-fzoNJl c2"
        data-name="col-md-6 col-lg-4"
      >
        <div>
          <svg
            aria-label="pdf"
            className="c3"
            fill="#272727"
            height="24px"
            role="img"
          >
            pdf.svg
          </svg>
        </div>
        <div>
          <p
            className="c4"
          >
            SISTEMA DE INFORMAÇÕES DE CRÉDITO - SRC
          </p>
          <p
            className="c5"
          >
            Aqui, você tem mais informações legais sobre consórcio.
          </p>
          <p
            className="c6"
            data-gtm-clicktype="link"
            data-gtm-name="BAIXAR ARQUIVO"
            data-gtm-subname="SISTEMA DE INFORMAÇÕES DE CRÉDITO - SRC"
            data-gtm-type="click"
            onClick={[Function]}
          >
            BAIXAR ARQUIVO
             &gt;
             
          </p>
        </div>
      </div>
      <div
        className="sc-fzoNJl c2"
        data-name="col-md-6 col-lg-4"
      >
        <div>
          <svg
            aria-label="pdf"
            className="c3"
            fill="#272727"
            height="24px"
            role="img"
          >
            pdf.svg
          </svg>
        </div>
        <div>
          <p
            className="c4"
          >
            CONDIÇÕES GERAIS
          </p>
          <p
            className="c5"
          >
            Mais detalhes sobre as condições de contratação, taxas de juros e outras informações sobre o Consórcio de Imóveis da Porto Seguro.
          </p>
          <p
            className="c6"
            data-gtm-clicktype="link"
            data-gtm-name="BAIXAR ARQUIVO"
            data-gtm-subname="CONDIÇÕES GERAIS"
            data-gtm-type="click"
            onClick={[Function]}
          >
            BAIXAR ARQUIVO
             &gt;
             
          </p>
        </div>
      </div>
      <div
        className="sc-fzoNJl c2"
        data-name="col-md-6 col-lg-4"
      >
        <div>
          <svg
            aria-label="pdf"
            className="c3"
            fill="#272727"
            height="24px"
            role="img"
          >
            pdf.svg
          </svg>
        </div>
        <div>
          <p
            className="c4"
          >
            TABELA DE TARIFAS
          </p>
          <p
            className="c5"
          >
            Confira mais informações sobre tarifas envolvidas na contratação de consórcio.
          </p>
          <p
            className="c6"
            data-gtm-clicktype="link"
            data-gtm-name="BAIXAR ARQUIVO"
            data-gtm-subname="TABELA DE TARIFAS"
            data-gtm-type="click"
            onClick={[Function]}
          >
            BAIXAR ARQUIVO
             &gt;
             
          </p>
        </div>
      </div>
    </div>
  </div>,
]
`;
