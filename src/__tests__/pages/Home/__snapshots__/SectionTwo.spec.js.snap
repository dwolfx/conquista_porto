                >
                  arrow-right.svg
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        className="c2"
        data-name="col-xs-6 col-md-4"
      >
        <div
          className="c3 c4 c5"
          onClick={[Function]}
        >
          <div
            className="c6 c7"
          >
            <div
              className="c8"
            >
              <svg
                aria-label="add"
                role="img"
              >
                add.svg
              </svg>
            </div>
            <div
              className="c9"
            >
              <p
                className="c10 c11"
                color="unset"
                type="headline"
              >
                Criar objetivo
              </p>
              <button
                className="c12"
                data-gtm-clicktype="button"
                data-gtm-name="Criar objetivo"
                data-gtm-type="click"
                size="small"
              >
                <svg
                  aria-label="arrowright"
                  role="img"
                >
                  arrow-right.svg
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      className="c13"
      data-name="row"
    >
      <div
        className="c14"
        data-name="col-md-12"
      >
        <div
          className="c15 c16"
          size="sm"
        >
          <div
            className="c17"
            data-name="container"
          >
            <div
              className="c18"
              data-name="row justify-content-start"
            >
              <div
                className="c19"
                data-name="col-xs-12 col-sm-12 col-md-12 col-lg-12"
              >
                <p
                  className="c20 c21"
                  color="unset"
                  type="captionUppercase"
                >
                  Dicas para economizar
                </p>
                <div
                  className=""
                >
                  <p
                    className="c22 c23"
                    color="unset"
                    type="body"
                  >
                    Registre todas as despesas
                  </p>
                  <p
                    className="c24"
                    color="unset"
                    type="body"
                  >
                    O primeiro passo para começar a poupar e controlar seu dinheiro é descobrir onde ele está. 
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>,
]
`;
