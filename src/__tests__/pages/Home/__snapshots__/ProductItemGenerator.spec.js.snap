exports[`ProductItemGenerator financiamentoVeiculo and not products list Renders correctly 1`] = `
.c4 {
  color: #898989;
  text-align: unset;
  font-weight: 300;
  font-family: Open Sans;
  font-size: 18px;
  -webkit-letter-spacing: 0;
  -moz-letter-spacing: 0;
  -ms-letter-spacing: 0;
  letter-spacing: 0;
  line-height: 25px;
}

.c6 {
  background: linear-gradient( to left, #2F736B -35%, #46A166 );
  background-repeat: no-repeat;
  border: none;
  border-radius: 4px;
  box-sizing: border-box;
  display: inline-block;
  color: #FFFFFF;
  cursor: pointer;
  height: 35px;
  overflow: hidden;
  position: relative;
  -webkit-text-decoration: none;
  text-decoration: none;
  -webkit-transition: all 0.4s ease-out;
  transition: all 0.4s ease-out;
}

.c6:hover:active {
  pointer-events: auto;
}

.c6:hover:active:after {
  background-color: #2F736B;
  background-size: 100%;
  opacity: 0.2;
  -webkit-transition: all ease 0s;
  transition: all ease 0s;
}

.c6:hover:before {
  width: 100%;
}

.c6:hover:after {
  background: transparent radial-gradient( circle, #000 1%, transparent 1% ) center/15000%;
  background-position: center;
  content: '';
  height: 100%;
  left: 0;
  opacity: 0;
  pointer-events: none;
  position: absolute;
  top: 0;
  -webkit-transition: all ease 0.8s;
